{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "lab-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "LAB_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "lab-debug",
      "displayName": "Laboratory debug",
      "inherits": "lab-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "lab-release",
      "displayName": "Laboratory release",
      "inherits": "lab-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "lab-sanitize",
      "displayName": "Laboratory debug with sanitizers",
      "inherits": "lab-debug",
      "cacheVariables": {
        "LAB_SANITIZERS": "ON"
      }
    },
    {
      "name": "lab-failure-probe",
      "displayName": "Laboratory debug plus deliberately failing tests",
      "inherits": "lab-debug",
      "cacheVariables": {
        "LAB_PROBE_FAILURES": "ON"
      }
    },
    {
      "name": "app-debug",
      "displayName": "Desktop frontend debug with pinned SDL3",
      "inherits": "lab-debug",
      "cacheVariables": {
        "LAB_BUILD_APP": "ON"
      }
    },
    {
      "name": "app-release",
      "displayName": "Desktop frontend optimized with pinned SDL3",
      "inherits": "lab-release",
      "cacheVariables": {
        "LAB_BUILD_APP": "ON"
      }
    },
    {
      "name": "app-sanitize",
      "displayName": "Desktop frontend with sanitizers and pinned SDL3",
      "inherits": "lab-sanitize",
      "cacheVariables": {
        "LAB_BUILD_APP": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "lab-debug",
      "configurePreset": "lab-debug"
    },
    {
      "name": "lab-release",
      "configurePreset": "lab-release"
    },
    {
      "name": "lab-sanitize",
      "configurePreset": "lab-sanitize"
    },
    {
      "name": "lab-failure-probe",
      "configurePreset": "lab-failure-probe"
    },
    {
      "name": "app-debug",
      "configurePreset": "app-debug"
    },
    {
      "name": "app-release",
      "configurePreset": "app-release"
    },
    {
      "name": "app-sanitize",
      "configurePreset": "app-sanitize"
    }
  ],
  "testPresets": [
    {
      "name": "lab-debug",
      "configurePreset": "lab-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "lab-release",
      "configurePreset": "lab-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "lab-sanitize",
      "configurePreset": "lab-sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "lab-failure-probe",
      "configurePreset": "lab-failure-probe",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "app-debug",
      "configurePreset": "app-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "app-release",
      "configurePreset": "app-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "app-sanitize",
      "configurePreset": "app-sanitize",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
