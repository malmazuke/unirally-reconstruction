# src/core format (NATIVE-READABILITY); it applies to this directory only.
# Four-space indentation and attached braces follow most of the recovered code;
# 100 columns keep a side-by-side review readable. Short guards stay on one
# line so a function's line count measures its logic, not its layout.
BasedOnStyle: LLVM
Language: Cpp
Standard: c++20
IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
NamespaceIndentation: None
FixNamespaceComments: false
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortBlocksOnASingleLine: Empty
AllowShortFunctionsOnASingleLine: Inline
AllowShortCaseLabelsOnASingleLine: true
AllowShortEnumsOnASingleLine: true
AlwaysBreakTemplateDeclarations: Yes
PointerAlignment: Left
ReferenceAlignment: Left
SpaceBeforeParens: ControlStatements
Cpp11BracedListStyle: true
SortIncludes: CaseSensitive
IncludeBlocks: Preserve
ReflowComments: false
BreakBeforeBinaryOperators: NonAssignment
AlignOperands: AlignAfterOperator
PackConstructorInitializers: NextLine
