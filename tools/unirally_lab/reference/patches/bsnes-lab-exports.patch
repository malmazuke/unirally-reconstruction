diff --git a/bsnes/target-libretro/unirally.cpp b/bsnes/target-libretro/unirally.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7283babe7e4eb36d7898be1178e7b27266935200
--- /dev/null
+++ b/bsnes/target-libretro/unirally.cpp
@@ -0,0 +1,112 @@
+// unirally-lab extensions for the bsnes libretro build.
+// These exports are not part of the libretro API; tools/unirally_lab/reference
+// loads the library directly and uses them for headless capture.
+#include <sfc/sfc.hpp>
+#include <new>
+#include "libretro.h"
+// ---- unirally-lab extensions -------------------------------------------------
+// Laboratory exports used by tools/unirally_lab/reference. They are not part of
+// the libretro API; the Python adapter loads the library directly.
+
+namespace UnirallyLab {
+#pragma pack(push, 1)
+struct Registers {
+	uint32_t pc;      // 24-bit program counter (bank in bits 16-23)
+	uint16_t a, x, y, s, d;
+	uint8_t b, p, e, mdr;
+	uint16_t vcounter, hcounter;
+	uint8_t field, wai, stp, reserved;
+};
+struct TraceEntry {
+	uint32_t pc;
+	uint16_t a, x, y, s, d;
+	uint8_t b, p, e, reserved;
+	uint16_t vcounter, hcounter;
+};
+#pragma pack(pop)
+static TraceEntry* ring = nullptr;
+static size_t ringCapacity = 0, ringHead = 0, ringCount = 0;
+static uint64_t traceTotal = 0;
+
+static void fill(TraceEntry& t) {
+	auto& c = SuperFamicom::cpu;
+	t.pc = (uint32_t)c.r.pc.d; t.a = c.r.a.w; t.x = c.r.x.w; t.y = c.r.y.w; t.s = c.r.s.w; t.d = c.r.d.w;
+	t.b = c.r.b; t.p = (uint8_t)(uint)c.r.p; t.e = c.r.e; t.reserved = 0;
+	t.vcounter = c.vcounter(); t.hcounter = c.hcounter();
+}
+
+static void hook() {
+	fill(ring[ringHead]);
+	ringHead = (ringHead + 1) % ringCapacity;
+	if(ringCount < ringCapacity) ringCount++;
+	traceTotal++;
+}
+}
+
+extern "C" {
+
+RETRO_API uint32_t unirally_api_version() { return 1; }
+
+// id 0: work RAM (128 KiB); id 1: cartridge RAM (save RAM, may be empty)
+RETRO_API void* unirally_memory(unsigned id, size_t* size) {
+	switch(id) {
+	case 0: if(size) *size = sizeof(SuperFamicom::cpu.wram); return SuperFamicom::cpu.wram;
+	case 1: if(size) *size = SuperFamicom::cartridge.ram.size(); return SuperFamicom::cartridge.ram.data();
+	}
+	if(size) *size = 0;
+	return nullptr;
+}
+
+RETRO_API size_t unirally_cpu_registers(void* out, size_t capacity) {
+	if(!out || capacity < sizeof(UnirallyLab::Registers)) return sizeof(UnirallyLab::Registers);
+	auto& c = SuperFamicom::cpu;
+	UnirallyLab::Registers r = {};
+	r.pc = (uint32_t)c.r.pc.d; r.a = c.r.a.w; r.x = c.r.x.w; r.y = c.r.y.w; r.s = c.r.s.w; r.d = c.r.d.w;
+	r.b = c.r.b; r.p = (uint8_t)(uint)c.r.p; r.e = c.r.e; r.mdr = c.r.mdr;
+	r.vcounter = c.vcounter(); r.hcounter = c.hcounter(); r.field = c.field(); r.wai = c.r.wai; r.stp = c.r.stp;
+	memcpy(out, &r, sizeof r);
+	return sizeof r;
+}
+
+// Reseed the emulator's entropy source so serialized states from identical runs are byte-identical.
+// With "Hacks/Entropy" = "None" the generator never influences emulation; only its serialized state changes.
+RETRO_API void unirally_reseed(uint32_t seed, uint32_t sequence) {
+	SuperFamicom::random.seed(seed, sequence);
+}
+
+// Keep the last `entries` executed instructions (0 disables). Returns false on allocation failure.
+RETRO_API bool unirally_trace_enable(size_t entries) {
+	delete[] UnirallyLab::ring; UnirallyLab::ring = nullptr;
+	UnirallyLab::ringCapacity = UnirallyLab::ringHead = UnirallyLab::ringCount = 0;
+	UnirallyLab::traceTotal = 0;
+	SuperFamicom::cpu.instructionHook = nullptr;
+	if(entries == 0) return true;
+	UnirallyLab::ring = new(std::nothrow) UnirallyLab::TraceEntry[entries];
+	if(!UnirallyLab::ring) return false;
+	UnirallyLab::ringCapacity = entries;
+	SuperFamicom::cpu.instructionHook = &UnirallyLab::hook;
+	return true;
+}
+
+// Copy up to max_entries of the trace window, oldest first. Returns the number copied.
+RETRO_API size_t unirally_trace_read(void* out, size_t max_entries) {
+	size_t n = UnirallyLab::ringCount < max_entries ? UnirallyLab::ringCount : max_entries;
+	auto dst = static_cast<UnirallyLab::TraceEntry*>(out);
+	size_t start = (UnirallyLab::ringHead + UnirallyLab::ringCapacity - UnirallyLab::ringCount) % (UnirallyLab::ringCapacity ? UnirallyLab::ringCapacity : 1);
+	for(size_t i = 0; i < n; i++) dst[i] = UnirallyLab::ring[(start + i) % UnirallyLab::ringCapacity];
+	return n;
+}
+
+// Select bsnes' save-state synchronization method ("Fast" or "Strict", see sfc/system/system.cpp).
+// Returns false for any other value and leaves the setting unchanged.
+RETRO_API bool unirally_set_serialization_method(const char* method) {
+	nall::string value = method ? method : "";
+	if(value != "Fast" && value != "Strict") return false;
+	SuperFamicom::configuration.system.serialization.method = value;
+	return true;
+}
+
+RETRO_API uint64_t unirally_trace_total() { return UnirallyLab::traceTotal; }
+RETRO_API size_t unirally_trace_entry_size() { return sizeof(UnirallyLab::TraceEntry); }
+
+}
