+//unirally-lab: the latch state and the buttons captured at the last latch were not serialized upstream,
+//so a state taken inside the auto-joypad poll window restored with the remaining bits reading as zero.
+auto Gamepad::serialize(serializer& s) -> void {
+  s.boolean(latched);
+  s.integer(counter);
+  s.boolean(b); s.boolean(y); s.boolean(select); s.boolean(start);
+  s.boolean(up); s.boolean(down); s.boolean(left); s.boolean(right);
+  s.boolean(a); s.boolean(x); s.boolean(l); s.boolean(r);
+}
