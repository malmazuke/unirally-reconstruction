+extern "C" {
+RETRO_API bool unirally_audio_watch_cpu(const uint32_t* pcs, size_t count) {
+  if(count > 64 || (count && !pcs)) return false;
+  for(size_t i = 0; i < count; i++) if(pcs[i] > 0xffffff) return false;
+  for(size_t i = 0; i < count; i++) UnirallyAudioLab::watchedCpuPc[i] = pcs[i];
+  UnirallyAudioLab::watchedCpuCount = count;
+  return true;
+}
